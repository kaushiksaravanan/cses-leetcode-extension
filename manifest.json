{
  "manifest_version": 3,
  "name": "CSES LeetCode Interface",
  "version": "1.0.0",
  "description": "A clean LeetCode-style code editor for CSES problem pages with submission tracking and progress overview.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "host_permissions": [
    "https://cses.fi/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://cses.fi/problemset/task/*", "https://cses.fi/problemset/", "https://cses.fi/problemset"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CSES LeetCode Interface"
  }
}
